generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Piloto {
  id        String     @id @default(cuid())
  nombre    String
  org       String     @default("APEX SYNDICATE")
  fechaAlta DateTime   @default(now())
  resultados Resultado[]
}

model Resultado {
  id                     String   @id @default(cuid())
  pilotoId               String
  piloto                 Piloto   @relation(fields: [pilotoId], references: [id], onDelete: Cascade)
  fecha                  DateTime @default(now())
  puntuacionRiesgo       Int
  puntuacionCautela      Int
  puntuacionCooperacion  Int
  puntuacionDisciplina   Int
  puntuacionIniciativa   Int
  puntuacionLiderazgo    Int
  respuestasCrudas       String  // JSON.stringify de las respuestas MÁS/MENOS por pregunta
  comentarios            String? // JSON.stringify de comentarios libres por pregunta, si los hay
  analisisPersonalizado  String? // Generado por IA solo en envíos nuevos; null en resultados antiguos

  @@index([pilotoId])
}
